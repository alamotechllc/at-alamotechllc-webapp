rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function staffEmail() {
      return signedIn()
        && authEmail() is string
        && (
          (
            authEmail().matches('^[^@]+@alamotechllc[.]com$')
            && request.auth.token.firebase.sign_in_provider == 'google.com'
          )
          || authEmail().matches('^[^@]+@alamotechllc[.]test$')
        );
    }

    function adminPath() {
      return /databases/$(database)/documents/platformAdmins/$(request.auth.uid);
    }

    function operatorPath() {
      return /databases/$(database)/documents/operators/$(request.auth.uid);
    }

    function memberPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function isPlatformAdmin() {
      return staffEmail()
        && exists(adminPath())
        && get(adminPath()).data.status == 'active'
        && get(adminPath()).data.email == authEmail();
    }

    function isOperator() {
      return staffEmail()
        && exists(operatorPath())
        && get(operatorPath()).data.status == 'active'
        && get(operatorPath()).data.email == authEmail();
    }

    function assignedOperator(tenantId) {
      return isOperator()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid)/assignments/$(tenantId));
    }

    function memberRole(tenantId, role) {
      return exists(memberPath(tenantId))
        && get(memberPath(tenantId)).data.status == 'active'
        && get(memberPath(tenantId)).data.role == role;
    }

    function isTenantAdmin(tenantId) {
      return memberRole(tenantId, 'tenant_admin');
    }

    function isTenantViewer(tenantId) {
      return memberRole(tenantId, 'tenant_viewer');
    }

    function canReadTenant(tenantId) {
      return isPlatformAdmin()
        || assignedOperator(tenantId)
        || isTenantAdmin(tenantId)
        || isTenantViewer(tenantId);
    }

    function actionPath(tenantId, actionId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/actions/$(actionId);
    }

    function actionVisibleToCaller(data) {
      return data.assignedTo == 'all' || data.assignedTo == request.auth.uid;
    }

    function validNewActionCompletion(tenantId, actionId) {
      let data = request.resource.data;
      return exists(actionPath(tenantId, actionId))
        && get(actionPath(tenantId, actionId)).data.tenantId == tenantId
        && actionVisibleToCaller(get(actionPath(tenantId, actionId)).data)
        && data.keys().hasOnly(['actionId', 'tenantId', 'completedAt'])
        && data.actionId == actionId
        && actionId.matches('^act_[a-z0-9_]+$')
        && data.tenantId == tenantId
        && data.completedAt is string
        && data.completedAt.size() >= 20
        && data.completedAt.size() <= 40;
    }

    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /operators/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /assignments/{tenantId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /tenants/{tenantId} {
      allow read: if canReadTenant(tenantId);
      allow write: if false;

      match /serviceInstances/{instanceId} {
        allow read: if canReadTenant(tenantId);
        allow write: if false;
      }

      match /campaigns/{campaignId} {
        allow read: if canReadTenant(tenantId);
        allow write: if false;
      }

      match /leads/{leadId} {
        allow read: if canReadTenant(tenantId);
        allow write: if false;
      }

      match /appointments/{appointmentId} {
        allow read: if canReadTenant(tenantId);
        allow write: if false;
      }

      match /tasks/{taskId} {
        allow read: if canReadTenant(tenantId);
        allow create: if canManageTasks(tenantId) && validNewTask(tenantId, taskId);
        allow update: if canManageTasks(tenantId) && validTaskUpdate();
        allow delete: if false;
      }

      match /actions/{actionId} {
        allow read: if canReadTenant(tenantId) && actionVisibleToCaller(resource.data);
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;

        match /actionCompletions/{actionId} {
          allow read: if signedIn() && request.auth.uid == uid && canReadTenant(tenantId);
          allow create: if signedIn()
            && request.auth.uid == uid
            && canReadTenant(tenantId)
            && validNewActionCompletion(tenantId, actionId);
          allow update: if false;
          allow delete: if false;
        }
      }
    }

    function canManageTasks(tenantId) {
      return isPlatformAdmin() || assignedOperator(tenantId) || isTenantAdmin(tenantId);
    }

    function validDue(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validTaskIdentity(data, tenantId, taskId) {
      return data.taskId == taskId
        && taskId.matches('^tsk_[0-9a-f]{32}$')
        && data.tenantId == tenantId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.detail is string
        && data.detail.size() <= 1000
        && validDue(data.dueOn)
        && data.createdAt is string
        && data.createdAt.size() >= 20
        && data.createdAt.size() <= 40
        && data.createdByUid == request.auth.uid;
    }

    function validNewTask(tenantId, taskId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['taskId', 'tenantId', 'title', 'detail', 'dueOn', 'status', 'createdAt', 'createdByUid', 'completedAt'])
        && validTaskIdentity(data, tenantId, taskId)
        && data.status == 'open'
        && data.completedAt == null;
    }

    function validTaskUpdate() {
      let next = request.resource.data;
      let current = resource.data;
      return next.diff(current).affectedKeys().hasOnly(['status', 'completedAt'])
        && next.taskId == current.taskId
        && next.tenantId == current.tenantId
        && next.title == current.title
        && next.detail == current.detail
        && next.dueOn == current.dueOn
        && next.createdAt == current.createdAt
        && next.createdByUid == current.createdByUid
        && (
          (next.status == 'open' && next.completedAt == null)
          || (next.status == 'done' && next.completedAt is string && next.completedAt.size() >= 20 && next.completedAt.size() <= 40)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
