{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ghl-app.schema.json",
  "$comment": "Generated by the GHL CLI. Run `ghl app types` to regenerate. Do not edit manually.",
  "title": "HighLevel App Manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Local JSON Schema used by editors. The CLI treats this property as file metadata."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Generated manifest schema version."
    },
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "Read-only HighLevel app identifier from the last pull."
    },
    "versionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "Read-only HighLevel app version identifier from the last pull."
    },
    "createdAt": {
      "type": "string",
      "description": "Read-only app creation timestamp used by billing eligibility checks."
    },
    "version": {
      "type": "string",
      "description": "Read-only marketplace version from the last pull."
    },
    "status": {
      "type": "string",
      "description": "Read-only marketplace version status from the last pull."
    },
    "appType": {
      "type": "string",
      "description": "Read-only app type, normally standard or template."
    },
    "basicInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 50,
          "description": "App name. Standard apps require 1–50 characters and at least one visible character."
        },
        "tagline": {
          "type": "string",
          "maxLength": 170,
          "description": "Marketplace tagline. Standard apps require 20–170 characters after trimming."
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 50,
          "description": "Publisher company name; 1–50 characters."
        },
        "contact": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Read-only publisher contact name from the last pull."
            },
            "email": {
              "type": "string",
              "description": "Read-only publisher contact email from the last pull."
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        },
        "website": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://)",
          "description": "Optional publisher website; must be a valid HTTPS URL."
        },
        "category": {
          "type": "string",
          "description": "Read-only legacy category returned by the marketplace."
        },
        "subcategory": {
          "type": "array",
          "items": {
            "enum": [
              "advertising",
              "analytics & data",
              "content management system",
              "data management",
              "e-commerce",
              "email",
              "events",
              "lead generation",
              "live chat",
              "marketing automation",
              "seo",
              "sms",
              "social media",
              "video",
              "webinar",
              "website builder",
              "wordpress",
              "crm",
              "calendar & scheduling",
              "calling",
              "sales enablement",
              "customer success",
              "employee engagement",
              "field service management",
              "help desk & ticketing",
              "survey",
              "whitelabel payment provider",
              "third party provider",
              "payment provider",
              "workflow automation",
              "erp",
              "learning management system",
              "project management",
              "accounting & payments",
              "payroll",
              "virtual assistants",
              "other services",
              "other"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Select between one and three marketplace subcategories."
        },
        "businessNiche": {
          "type": "array",
          "items": {
            "enum": [
              "advertising agency",
              "car dealership",
              "chiropractor",
              "construction",
              "consultant",
              "dental",
              "education",
              "energy",
              "financial services",
              "fitness",
              "health",
              "home services",
              "hospitality",
              "insurance",
              "legal",
              "life coach",
              "loan & mortgage",
              "marketing agency",
              "medical",
              "real estate",
              "recruitment",
              "retail",
              "solar",
              "spa & wellness"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Select up to three marketplace business niches."
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://.*\\.(?:[pP][nN][gG]|[jJ][pP](?:[eE])?[gG]|[sS][vV][gG]|[gG][iI][fF])(?:[?#].*)?$)",
          "description": "Optional logo URL; must use HTTPS and end in .png, .jpg, .jpeg, .svg, or .gif."
        }
      },
      "required": [
        "name",
        "tagline",
        "companyName",
        "contact",
        "website",
        "category",
        "subcategory",
        "businessNiche",
        "logoUrl"
      ],
      "additionalProperties": false
    },
    "listing": {
      "type": "object",
      "properties": {
        "private": {
          "type": "boolean",
          "description": "Whether the app listing is private."
        },
        "userTypes": {
          "type": "array",
          "items": {
            "enum": [
              "Company",
              "Location"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "description": "Install targets: Company for agencies and Location for sub-accounts."
        },
        "isWhiteLabelFriendly": {
          "type": "boolean",
          "description": "Whether marketplace branding must be white-label safe."
        },
        "isAgencyBulkInstallEnabled": {
          "type": "boolean",
          "description": "Must be enabled when both Company and Location are selected, and disabled for Company-only apps."
        },
        "searchKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 200
          },
          "uniqueItems": true,
          "description": "Unique, non-blank search keywords with at most 200 characters in total. The CLI enforces the total."
        }
      },
      "required": [
        "private",
        "userTypes",
        "isWhiteLabelFriendly",
        "isAgencyBulkInstallEnabled",
        "searchKeywords"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "userTypes": {
                "const": [
                  "Company"
                ]
              }
            },
            "required": [
              "userTypes"
            ]
          },
          "then": {
            "properties": {
              "isAgencyBulkInstallEnabled": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "userTypes": {
                "allOf": [
                  {
                    "contains": {
                      "const": "Company"
                    }
                  },
                  {
                    "contains": {
                      "const": "Location"
                    }
                  }
                ]
              }
            },
            "required": [
              "userTypes"
            ]
          },
          "then": {
            "properties": {
              "isAgencyBulkInstallEnabled": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "profiles": {
      "type": "object",
      "properties": {
        "agency": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 10000,
              "description": "Agency marketplace description. Must contain 300–5,000 plain-text characters; HTML tags do not count."
            },
            "previewImageUrls": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^(?:$|https://.*\\.(?:[pP][nN][gG]|[jJ][pP](?:[eE])?[gG]|[sS][vV][gG]|[gG][iI][fF])(?:[?#].*)?$)",
                "description": "Agency screenshot URL; must use HTTPS and a supported image extension."
              },
              "maxItems": 9,
              "description": "Up to 9 agency profile screenshots."
            },
            "previewVideoUrl": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(?:$|https://(?:www\\.)?youtube\\.com/(?:watch\\?.*v=|embed/)[A-Za-z0-9_-]{11}(?:[&#?].*)?$|https://youtu\\.be/[A-Za-z0-9_-]{11}(?:[?#].*)?$)",
              "description": "Optional agency preview video; must be a supported HTTPS YouTube URL."
            }
          },
          "required": [
            "description",
            "previewImageUrls",
            "previewVideoUrl"
          ],
          "additionalProperties": false
        },
        "subAccount": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether a separate sub-account marketplace profile is enabled."
            },
            "description": {
              "type": "string",
              "maxLength": 10000,
              "description": "Sub-account marketplace description. Must contain 300–5,000 plain-text characters; HTML tags do not count."
            },
            "previewImageUrls": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^(?:$|https://.*\\.(?:[pP][nN][gG]|[jJ][pP](?:[eE])?[gG]|[sS][vV][gG]|[gG][iI][fF])(?:[?#].*)?$)",
                "description": "Sub-account screenshot URL; must use HTTPS and a supported image extension."
              },
              "maxItems": 9,
              "description": "Sub-account screenshots; an enabled profile requires 3–9."
            },
            "previewVideoUrl": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(?:$|https://(?:www\\.)?youtube\\.com/(?:watch\\?.*v=|embed/)[A-Za-z0-9_-]{11}(?:[&#?].*)?$|https://youtu\\.be/[A-Za-z0-9_-]{11}(?:[?#].*)?$)",
              "description": "Optional sub-account preview video; must be a supported HTTPS YouTube URL."
            }
          },
          "required": [
            "enabled",
            "description",
            "previewImageUrls",
            "previewVideoUrl"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 300,
                    "pattern": "\\S",
                    "maxLength": 10000
                  },
                  "previewImageUrls": {
                    "minItems": 3
                  }
                }
              },
              "else": {
                "properties": {
                  "description": {
                    "const": ""
                  },
                  "previewImageUrls": {
                    "maxItems": 0
                  },
                  "previewVideoUrl": {
                    "const": ""
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "agency",
        "subAccount"
      ],
      "additionalProperties": false
    },
    "oauth": {
      "type": "object",
      "properties": {
        "allowedScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,199}$"
          },
          "uniqueItems": true,
          "description": "Unique OAuth scopes. The CLI validates them against the live scope catalog before push."
        },
        "redirectUris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://",
            "maxLength": 2048,
            "description": "OAuth redirect URL; must use HTTP or HTTPS."
          },
          "uniqueItems": true,
          "description": "Unique OAuth redirect URLs using HTTP or HTTPS."
        },
        "defaults": {
          "type": "object",
          "properties": {
            "clientKey": {
              "type": [
                "string",
                "null"
              ],
              "description": "Read-only default OAuth client key id; use `ghl app keys` to change it."
            },
            "redirectUrl": {
              "type": [
                "string",
                "null"
              ],
              "description": "Default redirect URL; it must also appear in redirectUris."
            }
          },
          "required": [
            "clientKey",
            "redirectUrl"
          ],
          "additionalProperties": false
        },
        "clientKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Read-only OAuth client key id."
              },
              "name": {
                "type": "string",
                "description": "Read-only OAuth client key name."
              },
              "isDefault": {
                "type": "boolean",
                "description": "Whether this is the default OAuth client key."
              }
            },
            "required": [
              "id",
              "name",
              "isDefault"
            ],
            "additionalProperties": false
          },
          "description": "Read-only OAuth client keys; manage them with `ghl app keys`."
        }
      },
      "required": [
        "allowedScopes",
        "redirectUris",
        "defaults",
        "clientKeys"
      ],
      "additionalProperties": false
    },
    "supportConfig": {
      "type": "object",
      "properties": {
        "supportEmail": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^(?:$|[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@(?:[^\\s@]+\\.[A-Za-z]{2,63}|\\[(?:\\d{1,3}\\.){3}\\d{1,3}\\]))$",
          "description": "Support email. Either supportEmail or supportPhone must be provided."
        },
        "supportPhone": {
          "type": "string",
          "pattern": "^(?:$|(?=(?:\\D*\\d){7,15}\\D*$)\\+?[\\d()\\s.-]+)$",
          "description": "Support phone. Either supportEmail or supportPhone must be provided; phone numbers need 7–15 digits."
        },
        "websiteUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://.*|(?!(?:[A-Za-z][A-Za-z0-9+.-]*):\\/\\/).+)$",
          "description": "Optional support website; a missing scheme is treated as HTTPS."
        },
        "documentationUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://.*|(?!(?:[A-Za-z][A-Za-z0-9+.-]*):\\/\\/).+)$",
          "description": "Optional documentation page; a missing scheme is treated as HTTPS."
        },
        "termsAndConditionsUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://.*|(?!(?:[A-Za-z][A-Za-z0-9+.-]*):\\/\\/).+)$",
          "description": "Optional terms and conditions page; a missing scheme is treated as HTTPS."
        },
        "privacyPolicyUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://.*|(?!(?:[A-Za-z][A-Za-z0-9+.-]*):\\/\\/).+)$",
          "description": "Optional privacy policy page; a missing scheme is treated as HTTPS."
        },
        "supportedServices": {
          "type": "array",
          "items": {
            "enum": [
              "author_availability",
              "technical_questions",
              "bug_assistance",
              "third_party_assets",
              "customization_services",
              "installation_services"
            ]
          },
          "uniqueItems": true,
          "description": "Supported service categories. Template apps require at least one."
        }
      },
      "required": [
        "supportEmail",
        "supportPhone",
        "websiteUrl",
        "documentationUrl",
        "termsAndConditionsUrl",
        "privacyPolicyUrl",
        "supportedServices"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "supportEmail": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "supportEmail"
          ]
        },
        {
          "properties": {
            "supportPhone": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "supportPhone"
          ]
        }
      ]
    },
    "billing": {
      "type": "object",
      "properties": {
        "billingType": {
          "enum": [
            "free",
            "freemium",
            "paid"
          ],
          "description": "Marketplace billing model."
        },
        "isPaidApp": {
          "type": "boolean",
          "description": "Read-only value derived from billingType."
        },
        "isFreemium": {
          "type": "boolean",
          "description": "Read-only value derived from billingType."
        },
        "externalBilling": {
          "type": "boolean",
          "description": "Whether paid billing is handled by an external provider."
        },
        "externalBillingUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://.*|(?!(?:[A-Za-z][A-Za-z0-9+.-]*):\\/\\/).+)$",
          "description": "External billing host or HTTPS URL. Required only when externalBilling is enabled."
        },
        "hasFreeTrial": {
          "type": "boolean",
          "description": "Whether this paid or freemium app offers a free trial."
        },
        "freeTrialDuration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 90,
          "description": "Trial duration in days (1–90), or null when free trials are disabled."
        },
        "hasUsageBasedPrice": {
          "type": "boolean",
          "description": "Read-only usage-based billing state."
        },
        "paymentType": {
          "type": "string",
          "description": "Read-only payment type derived from subscription plans."
        },
        "oneTimePrice": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Read-only one-time price."
        },
        "additionalInfoForBilling": {
          "type": "string",
          "description": "Read-only billing information returned by the marketplace."
        }
      },
      "required": [
        "billingType",
        "isPaidApp",
        "isFreemium",
        "externalBilling",
        "externalBillingUrl",
        "hasFreeTrial",
        "freeTrialDuration",
        "hasUsageBasedPrice",
        "paymentType",
        "oneTimePrice",
        "additionalInfoForBilling"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "billingType": {
                "const": "free"
              }
            },
            "required": [
              "billingType"
            ]
          },
          "then": {
            "properties": {
              "isPaidApp": {
                "const": false
              },
              "isFreemium": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billingType": {
                "const": "paid"
              }
            },
            "required": [
              "billingType"
            ]
          },
          "then": {
            "properties": {
              "isPaidApp": {
                "const": true
              },
              "isFreemium": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billingType": {
                "const": "freemium"
              }
            },
            "required": [
              "billingType"
            ]
          },
          "then": {
            "properties": {
              "isPaidApp": {
                "const": true
              },
              "isFreemium": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "externalBilling": {
                "const": true
              }
            },
            "required": [
              "externalBilling"
            ]
          },
          "then": {
            "properties": {
              "billingType": {
                "const": "paid"
              },
              "externalBillingUrl": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 2048
              },
              "hasFreeTrial": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "externalBillingUrl": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hasFreeTrial": {
                "const": true
              }
            },
            "required": [
              "hasFreeTrial"
            ]
          },
          "then": {
            "properties": {
              "billingType": {
                "enum": [
                  "freemium",
                  "paid"
                ]
              },
              "externalBilling": {
                "const": false
              },
              "freeTrialDuration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 90
              }
            }
          },
          "else": {
            "properties": {
              "freeTrialDuration": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "endToEndDemoUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://)",
          "description": "End-to-end demo URL; required for standard app review and must use HTTPS."
        },
        "scopesDemoUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://)",
          "description": "OAuth scopes demo URL; required for standard app review and must use HTTPS."
        },
        "additionalDetails": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional app review notes; at most 500 characters."
        },
        "privateReason": {
          "type": "string",
          "maxLength": 500,
          "description": "Reason for a private listing; required for private apps and limited to 500 characters."
        }
      },
      "required": [
        "endToEndDemoUrl",
        "scopesDemoUrl",
        "additionalDetails",
        "privateReason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "appId",
    "versionId",
    "version",
    "status",
    "appType",
    "basicInfo",
    "listing",
    "profiles",
    "oauth",
    "supportConfig",
    "billing",
    "review"
  ],
  "additionalProperties": false,
  "description": "Editable local app manifest. The CLI also performs contextual, remote-catalog, and security checks.",
  "allOf": [
    {
      "if": {
        "properties": {
          "appType": {
            "not": {
              "const": "template"
            }
          }
        },
        "required": [
          "appType"
        ]
      },
      "then": {
        "properties": {
          "basicInfo": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 50
              },
              "tagline": {
                "type": "string",
                "minLength": 20,
                "pattern": "\\S",
                "maxLength": 170
              },
              "subcategory": {
                "minItems": 1
              }
            }
          },
          "profiles": {
            "properties": {
              "agency": {
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 300,
                    "pattern": "\\S",
                    "maxLength": 10000
                  }
                }
              }
            }
          },
          "review": {
            "properties": {
              "endToEndDemoUrl": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https://",
                "maxLength": 2048,
                "description": "Required end-to-end demo URL."
              },
              "scopesDemoUrl": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https://",
                "maxLength": 2048,
                "description": "Required OAuth scopes demo URL."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "appType": {
            "const": "template"
          }
        },
        "required": [
          "appType"
        ]
      },
      "then": {
        "properties": {
          "supportConfig": {
            "properties": {
              "supportedServices": {
                "minItems": 1
              }
            }
          },
          "billing": {
            "properties": {
              "billingType": {
                "enum": [
