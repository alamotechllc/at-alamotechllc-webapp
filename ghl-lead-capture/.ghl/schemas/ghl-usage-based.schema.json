{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ghl-usage-based.schema.json",
  "$comment": "Generated by the GHL CLI. Run `ghl app types` to regenerate. Do not edit manually.",
  "title": "HighLevel Usage-Based Billing",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Local JSON Schema used by editors. The CLI treats this property as file metadata."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Generated usage billing manifest schema version."
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "HighLevel app identifier associated with these meters."
    },
    "meters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/usageMeter"
      },
      "description": "Usage meters. The CLI checks unique ids/products and app-level billing eligibility."
    }
  },
  "required": [
    "schemaVersion",
    "appId",
    "meters"
  ],
  "additionalProperties": false,
  "definitions": {
    "usageTier": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Server-assigned tier id when present."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Non-blank tier name."
        },
        "minVolume": {
          "type": "number",
          "minimum": 0,
          "description": "Inclusive lower volume boundary."
        },
        "maxVolume": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Upper volume boundary, or null for the final open-ended tier. The CLI verifies it exceeds minVolume."
        },
        "pricePerUnit": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "Default price per unit; 0–200 with at most six decimal places. Use at most six decimal places."
        },
        "minPricePerUnit": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "Dynamic minimum price per unit. Use at most six decimal places."
        },
        "maxPricePerUnit": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "Dynamic maximum price per unit. Use at most six decimal places."
        },
        "executionLimitPerCycle": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum usage units allowed per day; 0 means no daily limit."
        }
      },
      "required": [
        "name",
        "minVolume",
        "maxVolume",
        "pricePerUnit",
        "executionLimitPerCycle"
      ],
      "additionalProperties": false
    },
    "usageMeter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Server-assigned meter id when present."
        },
        "productType": {
          "enum": [
            "conversation_provider",
            "workflow_action",
            "workflow_trigger",
            "custom"
          ],
          "description": "Product surface metered by this definition."
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 250,
          "description": "Product identifier. Custom products must use the custom_ prefix."
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Display name for the metered product."
        },
        "customPriceType": {
          "enum": [
            "fixed",
            "dynamic"
          ],
          "description": "Fixed or dynamic unit pricing."
        },
        "usageUnit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 19,
          "description": "Usage unit; workflow resources use execution."
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound"
          ],
          "description": "Required only for conversation providers."
        },
        "pricingPageUrl": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://",
          "maxLength": 2048,
          "description": "Required public HTTPS pricing page for dynamic custom pricing."
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/usageTier"
          },
          "minItems": 1,
          "description": "One or more non-overlapping usage tiers."
        }
      },
      "required": [
        "productType",
        "productId",
        "productName",
        "customPriceType",
        "usageUnit",
        "tiers"
      ],
      "additionalProperties": false,
      "description": "A usage meter. The CLI additionally resolves workflow references and checks tier ordering and uniqueness.",
      "allOf": [
        {
          "if": {
            "properties": {
              "productType": {
                "const": "custom"
              }
            },
            "required": [
              "productType"
            ]
          },
          "then": {
            "properties": {
              "productId": {
                "pattern": "^custom_[A-Za-z0-9_-]+$",
                "maxLength": 250
              }
            }
          },
          "else": {
            "properties": {
              "customPriceType": {
                "const": "fixed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "productType": {
                "const": "conversation_provider"
              }
            },
            "required": [
              "productType"
            ]
          },
          "then": {
            "properties": {
              "direction": {
                "enum": [
                  "inbound",
                  "outbound"
                ]
              },
              "usageUnit": {
                "const": "message"
              }
            },
            "required": [
              "direction"
            ]
          },
          "else": {
            "not": {
              "required": [
                "direction"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "productType": {
                "enum": [
                  "workflow_action",
                  "workflow_trigger"
                ]
              }
            },
            "required": [
              "productType"
            ]
          },
          "then": {
            "properties": {
              "usageUnit": {
                "const": "execution"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "customPriceType": {
                "const": "dynamic"
              }
            },
            "required": [
              "customPriceType"
            ]
          },
          "then": {
            "required": [
              "pricingPageUrl"
            ],
            "properties": {
              "tiers": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/usageTier"
                    },
                    {
                      "required": [
                        "minPricePerUnit",
                        "maxPricePerUnit"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "pricingPageUrl"
              ]
            },
            "properties": {
              "tiers": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/usageTier"
                    },
                    {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "minPricePerUnit"
                            ]
                          },
                          {
                            "required": [
                              "maxPricePerUnit"
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
