            "serviceName": {
              "const": ""
            },
            "route": {
              "const": ""
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "properties": {
            "url": {
              "const": ""
            },
            "serviceName": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "route": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "serviceName",
            "route"
          ]
        }
      ]
    },
    "dynamicFieldsConfig": {
