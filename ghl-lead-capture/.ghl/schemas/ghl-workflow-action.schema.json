{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ghl-workflow-action.schema.json",
  "$comment": "Generated by the GHL CLI. Run `ghl app types` to regenerate. Do not edit manually.",
  "title": "HighLevel Workflow Action",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Local JSON Schema used by editors. The CLI treats this property as file metadata."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Generated workflow action file schema version."
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^[a-z][_a-z0-9]*$",
      "description": "Stable action key. It must match the filename-derived key."
    },
    "templateId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Server-owned template id. Omit it for a new local action."
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/actionVersion"
      },
      "minItems": 1,
      "description": "Action versions. The CLI checks unique versions and allows at most one draft."
    }
  },
  "required": [
    "schemaVersion",
    "key",
    "versions"
  ],
  "additionalProperties": false,
  "definitions": {
    "actionInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Marketplace display name."
        },
        "description": {
          "type": "string",
          "description": "Marketplace description."
        },
        "summary": {
          "type": "string",
          "description": "Marketplace summary."
        },
        "groupName": {
          "type": "string",
          "description": "Optional workflow picker group."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workflow search keywords."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon identifier."
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://",
            "maxLength": 2048,
            "description": "Public HTTPS workflow screenshot URL."
          },
          "description": "Public HTTPS screenshot URLs."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "actionOption": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Option label shown to users."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Unique option value within the option list."
        },
        "description": {
          "type": "string",
          "description": "Optional option description."
        },
        "disabled": {
          "type": "boolean",
          "description": "Whether this option is disabled."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon identifier."
        },
        "iconUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://)",
          "description": "Optional public HTTPS option icon URL."
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "headers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "description": "HTTP header names and non-empty values. Header names must use RFC token characters."
    },
    "validationRule": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 1048576,
