        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://)",
          "description": "Required public HTTPS URL for an API option source."
        },
        "method": {
          "enum": [
            "DELETE",
            "GET",
            "PATCH",
            "POST",
            "PUT"
          ]
