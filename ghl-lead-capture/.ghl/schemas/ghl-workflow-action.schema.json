                },
                {
                  "required": [
                    "headers"
                  ]
                },
                {
                  "required": [
                    "labelField"
                  ]
                },
                {
                  "required": [
                    "valueField"
                  ]
                },
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "body"
                  ]
                },
                {
                  "required": [
                    "postProcessor"
                  ]
                }
