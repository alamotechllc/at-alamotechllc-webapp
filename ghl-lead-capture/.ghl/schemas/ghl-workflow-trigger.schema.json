{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ghl-workflow-trigger.schema.json",
  "$comment": "Generated by the GHL CLI. Run `ghl app types` to regenerate. Do not edit manually.",
  "title": "HighLevel Workflow Trigger",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Local JSON Schema used by editors. The CLI treats this property as file metadata."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Generated workflow trigger file schema version."
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^[a-z][_a-z0-9]*$",
      "description": "Stable trigger key. It must match the filename-derived key."
    },
    "templateId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Server-owned template id. Omit it for a new local trigger."
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/triggerVersion"
      },
      "minItems": 1,
      "description": "Trigger versions. The CLI checks unique versions and allows at most one draft."
    }
  },
  "required": [
    "schemaVersion",
    "key",
    "versions"
  ],
  "additionalProperties": false,
  "definitions": {
    "triggerInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Marketplace display name."
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Description with at most 200 characters."
        },
        "summary": {
          "type": "string",
          "maxLength": 500,
          "description": "Summary with at most 500 characters."
        },
        "groupName": {
          "type": "string",
          "description": "Optional workflow picker group."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workflow search keywords."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon identifier."
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://",
            "maxLength": 2048,
            "description": "Public HTTPS workflow screenshot URL."
          },
          "description": "Public HTTPS screenshot URLs."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "triggerOption": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Option label shown to users."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Unique option value within the option list."
        },
        "description": {
          "type": "string",
          "description": "Optional option description."
        },
        "disabled": {
          "type": "boolean",
          "description": "Whether this option is disabled."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon identifier."
        },
        "iconUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https://)",
          "description": "Optional public HTTPS option icon URL."
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "headers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "description": "HTTP header names and non-empty values. Header names must use RFC token characters."
    },
    "externalSource": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://",
          "maxLength": 2048,
          "description": "Required public HTTPS external source URL."
        },
        "headers": {
          "$ref": "#/definitions/headers"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "triggerFilter": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^\\S+$",
          "description": "Filter field or customVarsJson reference. Field names must be unique within the version."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Filter label shown to users."
        },
        "required": {
          "type": "boolean"
        },
        "fieldType": {
          "enum": [
            "DYNAMIC",
            "multiselect",
            "select",
            "string"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/triggerOption"
          },
          "minItems": 1
        },
        "fetchOptions": {
          "$ref": "#/definitions/externalSource"
        },
        "mappedTo": {
          "enum": [
            "COUNTRIES",
            "CAMPAIGNS",
            "TAGS",
            "PIPELINES",
            "FORMS",
            "SURVEYS",
            "LINKS",
            "FUNNELS",
            "GLOBAL_PRODUCTS",
            "USERS",
            "CALENDARS",
            "TEAMS",
            "MEMBERSHIP_PRODUCTS",
            "MEMBERSHIP_CATEGORIES",
            "MEMBERSHIP_LESSONS",
            "MEMBERSHIP_OFFERS",
            "WORKFLOWS",
            "PHONE_NUMBERS",
            "NUMBER_POOL",
            "AFFILIATES",
            "TIKTOK_POSTS"
          ]
        },
        "altersDynamicField": {
          "type": "boolean"
        },
        "dynamicFieldsConfig": {
          "$ref": "#/definitions/externalSource"
        }
      },
      "required": [
        "field",
        "title",
        "fieldType"
      ],
      "additionalProperties": false,
      "description": "Workflow trigger filter. Option sources and dynamic settings depend on fieldType.",
      "allOf": [
        {
          "if": {
            "properties": {
              "fieldType": {
                "enum": [
                  "select",
                  "multiselect"
                ]
              }
            },
            "required": [
              "fieldType"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "options"
                ]
              },
              {
                "required": [
                  "mappedTo"
                ]
              },
              {
                "required": [
                  "fetchOptions"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "fieldType": {
                "not": {
                  "enum": [
                    "select",
                    "multiselect"
                  ]
                }
              }
            },
            "required": [
              "fieldType"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "mappedTo"
                  ]
                },
                {
                  "required": [
                    "fetchOptions"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "fieldType": {
                "const": "DYNAMIC"
              }
            },
            "required": [
              "fieldType"
            ]
          },
          "then": {
            "properties": {
              "field": {
                "const": "DYNAMIC"
              },
              "required": {
                "not": {
                  "const": true
                }
              }
            },
            "required": [
              "dynamicFieldsConfig"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "altersDynamicField"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "dynamicFieldsConfig"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "triggerCustomVariable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^\\S+$"
        },
        "fieldType": {
          "enum": [
            "array",
            "boolean",
            "date",
            "numerical",
            "string"
          ]
        }
      },
      "required": [
        "name",
        "reference",
        "fieldType"
      ],
      "additionalProperties": false
    },
    "subscriptionConfig": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:$|https?://)",
          "description": "Public HTTP or HTTPS subscription callback URL."
        },
        "headers": {
          "$ref": "#/definitions/headers"
        }
      },
      "additionalProperties": false,
      "description": "Trigger subscription callback. Publishing requires a URL; configured headers also require one.",
      "allOf": [
        {
          "if": {
            "properties": {
              "headers": {
                "type": "object",
                "minProperties": 1
              }
            },
            "required": [
              "headers"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https?://",
                "maxLength": 2048,
                "description": "Required public HTTP or HTTPS subscription callback URL."
              }
            },
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "triggerVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 21,
          "pattern": "^\\d{1,10}\\.\\d{1,10}$",
          "description": "Trigger version in x.y format, for example 1.0."
        },
        "status": {
          "enum": [
            "draft",
            "in_review",
            "published"
          ],
          "description": "Server-managed trigger version status."
        },
        "info": {
          "$ref": "#/definitions/triggerInfo"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/triggerFilter"
          },
          "description": "Trigger filters. The CLI also checks unique fields and permits at most one DYNAMIC filter."
        },
        "customVars": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/triggerCustomVariable"
          }
        },
        "customVarsJson": {
          "type": "object"
        },
        "subscriptionConfig": {
          "$ref": "#/definitions/subscriptionConfig"
        }
      },
      "required": [
        "version",
        "status",
        "info"
      ],
      "additionalProperties": false,
      "description": "A workflow trigger version. Publish-only completeness and reference resolution are checked by the CLI.",
      "allOf": [
        {
          "if": {
            "properties": {
              "customVars": {
                "minItems": 1
              }
            },
            "required": [
              "customVars"
            ]
          },
          "then": {
            "properties": {
              "customVarsJson": {
                "type": "object",
                "minProperties": 1
              }
            },
            "required": [
              "customVarsJson"
            ]
          }
        }
      ]
    }
  },
  "description": "One editable workflow trigger file under src/modules/workflows/triggers.",
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "templateId"
          ]
        }
      },
      "then": {
        "properties": {
          "versions": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/definitions/triggerVersion"
                },
                {
                  "properties": {
                    "version": {
                      "const": "1.0"
                    },
                    "status": {
                      "const": "draft"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
